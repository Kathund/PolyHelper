{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "description": "!IMPORTANT DO NOT TOUCH\nConfig schema format path" },
    "configVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "!IMPORTANT DO NOT TOUCH\nConfig format version number"
    },
    "discord": {
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "The Discord bot token used to authenticate" },
        "serverId": { "type": "string", "description": "The Discord server (guild) ID" },
        "roles": {
          "type": "object",
          "properties": {
            "polyfrostTeam": { "type": "string", "description": "Discord role id" },
            "moderator": { "type": "string", "description": "Discord role id" },
            "support": { "type": "string", "description": "Discord role id" },
            "noCounting": { "type": "string", "description": "Discord role id" },
            "noGiveaway": { "type": "string", "description": "Discord role id" },
            "devAccess": { "type": "string", "description": "Discord role id" }
          },
          "required": ["polyfrostTeam", "moderator", "support", "noCounting", "noGiveaway", "devAccess"],
          "additionalProperties": false,
          "description": "Configuration options the discord roles"
        },
        "channels": {
          "type": "object",
          "properties": {
            "errorLog": {
              "description": "Discord channel id. If null, an auto-generated channel will be used",
              "type": ["string", "null"]
            },
            "support": { "type": "string", "description": "Discord channel id" },
            "ticketLogs": {
              "description": "Discord channel id. If null, an auto-generated channel will be used",
              "type": ["string", "null"]
            },
            "botLogs": {
              "description": "Discord channel id. If null, an auto-generated channel will be used",
              "type": ["string", "null"]
            },
            "sparkAnalysis": {
              "description": "Discord channel id. If null, an auto-generated channel will be used",
              "type": ["string", "null"]
            },
            "sparkFixes": {
              "description": "Discord channel id. If null, an auto-generated channel will be used",
              "type": ["string", "null"]
            }
          },
          "required": ["errorLog", "support", "ticketLogs", "botLogs", "sparkAnalysis", "sparkFixes"],
          "additionalProperties": false,
          "description": "Configuration options the discord channels"
        },
        "embeds": {
          "type": "object",
          "properties": {
            "colors": {
              "type": "object",
              "propertyNames": { "type": "string", "enum": ["Blue", "Gray", "Green", "Pink", "Red", "Yellow"] },
              "additionalProperties": { "type": "string" },
              "required": ["Blue", "Gray", "Green", "Pink", "Red", "Yellow"],
              "description": "The default colors for embeds"
            }
          },
          "required": ["colors"],
          "additionalProperties": false,
          "description": "Configuration options for embeds. Note that embeds aren't normally used in this project but the colors are used still"
        },
        "minecraftLogCleaner": { "type": "boolean", "description": "Should uploaded minecraft logs be cleaned" }
      },
      "required": ["token", "serverId", "roles", "channels", "embeds", "minecraftLogCleaner"],
      "additionalProperties": false,
      "description": "Configuration options for discord related stuff"
    },
    "logger": {
      "type": "object",
      "properties": {
        "saveToFiles": { "type": "boolean", "description": "Whether log output should be written to files" },
        "location": { "type": "string", "description": "The location of where these files should be saved" }
      },
      "required": ["saveToFiles", "location"],
      "additionalProperties": false,
      "description": "Configuration options for the logger"
    },
    "sparkAnalysis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Should /spark analyze spark profiles with Claude" },
        "anthropicApiKey": { "type": "string", "description": "The Anthropic API key used to run the Claude agents" },
        "githubToken": {
          "description": "GitHub token used to read mod source code. If null, code search is unavailable",
          "type": ["string", "null"]
        },
        "python": {
          "type": "string",
          "description": "The Python 3 command used to run the spark-analyzer skill script"
        }
      },
      "required": ["enabled", "anthropicApiKey", "githubToken", "python"],
      "additionalProperties": false,
      "description": "Configuration options for spark profile analysis"
    },
    "other": {
      "type": "object",
      "properties": {
        "configBackups": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "description": "Should config backups be made" },
            "location": { "type": "string", "description": "The location of where these files should be saved" }
          },
          "required": ["enabled", "location"],
          "additionalProperties": false,
          "description": "Configuration options for config backup system"
        },
        "sqlitedb": { "type": "string", "description": "Path to the sqlite database" }
      },
      "required": ["configBackups", "sqlitedb"],
      "additionalProperties": false,
      "description": "Configuration options for misc/other stuff or things that don't have a good location"
    }
  },
  "required": ["$schema", "configVersion", "discord", "logger", "sparkAnalysis", "other"],
  "additionalProperties": false
}
