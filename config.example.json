{
  "$schema": "./docs/config.schema.json",
  "configVersion": 4,
  "discord": {
    "token": "DICORD_TOKEN",
    "serverId": "DISCORD_SERVER_ID",
    "roles": {
      "polyfrostTeam": "DISCORD_ROLE_ID",
      "moderator": "DISCORD_ROLE_ID",
      "support": "DISCORD_ROLE_ID",
      "noCounting": "DISCORD_ROLE_ID",
      "noGiveaway": "DISCORD_ROLE_ID",
      "devAccess": "DISCORD_ROLE_ID"
    },
    "channels": {
      "errorLog": null,
      "support": "DISCORD_CHANNEL_ID",
      "ticketLogs": null,
      "botLogs": null,
      "sparkAnalysis": null
    },
    "embeds": {
      "colors": {
        "Blue": "#266FDD",
        "Gray": "#2D3943",
        "Green": "#3CAF77",
        "Pink": "#F5C2E7",
        "Red": "#F2545A",
        "Yellow": "#FFCB47"
      }
    },
    "minecraftLogCleaner": true
  },
  "logger": {
    "saveToFiles": true,
    "location": "./data/logs/{timestamp}"
  },
  "sparkAnalysis": {
    "enabled": false,
    "anthropicApiKey": "ANTHROPIC_API_KEY",
    "githubToken": null,
    "python": "python3",
    "model": "claude-sonnet-5-5",
    "helperModel": "claude-haiku-5-5",
    "effort": "medium",
    "maxTurns": 10,
    "costTarget": 0.1,
    "costCap": 0.15,
    "maxJars": 5,
    "jarCache": {
      "location": "./data/cache/jars",
      "maxMB": 500
    }
  },
  "other": {
    "configBackups": {
      "enabled": true,
      "location": "./data/backup/config/config_{timestamp}.json"
    },
    "sqlitedb": "./data/db.sqlite3"
  }
}
